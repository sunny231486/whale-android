.github/workflows/build-whale-apk.yml
# ==============================================================================
# 🐟 DeepSeek 大肥鱼（dsh-coopanion）安卓独立伴侣版 · 零代码云端一键自动打包配置
# ==============================================================================
#
# 【完全不会编程？只需在浏览器里做完这 4 步（约 3 分钟），GitHub 会自动帮你生成安卓安装包 APK】
#
# 第 1 步：打开 https://github.com 登录你的账号（没有的话免费注册一个），点击右上角「+」号 ->「New repository」
#         - Repository name（仓库名）随便填，比如：whale-android
#         - 勾选「Add a README file」，然后滑到最下面点击绿色按钮「Create repository」
#
# 第 2 步：在新建好的仓库页面，点击「Add file」->「Create new file」
#         - 在上方文件名输入框里，原封不动输入（包含前面的点和斜杠）：
#           .github/workflows/build-whale-apk.yml
#
# 第 3 步：把当前这份文件的【全部内容】复制粘贴进去，点击右上角绿色按钮「Commit changes...」保存。
#
# 第 4 步：保存后会自动开始打包！点击仓库顶部的「Actions」标签页：
#         - 你会看到一条正在转圈运行的任务（Build DeepSeek Whale Android APK），等待约 3~4 分钟变成绿色对勾 ✅
#         - 点进这条任务，滑到页面最底部的「Artifacts」区域，点击「DeepSeek-Whale-Android-APK」即可下载压缩包，
#           解压里面的 app-debug.apk 发到手机上安装即可！
#
# ==============================================================================
# ✨ 本自动打包脚本为你内置的全部功能：
# 1. 自动从 https://github.com/takboo/dsh-coopanion 提取「大肥鱼」角色贴图、骨骼组件与音效
# 2. 完整保留互动：单击戳一戳、头部滑动摸头（累计涨好感解锁爱心）、按住拖拽与松手抛掷落地物理
# 3. 系统内录互动（Android 10+ AudioPlaybackCapture）：
#    - 听歌律动：实时读取手机内部播放的音乐音量与节拍，大肥鱼跟着音乐节奏摇晃跳舞
#    - 看视频互动：可截取手机正在播放的视频/播客声音片段，转文字后让大肥鱼实时陪聊吐槽
# 4. 语音识别（ASR）：支持调用安卓系统自带语音识别，或通过 OpenAI 兼容 /audio/transcriptions 接口识别
# 5. 自定义第三方 OpenAI 接口：在 App 右上角「⚙️ 设置」中可自由填写任意 Base URL、API Key、模型名与人设提示词
# ==============================================================================

name: Build DeepSeek Whale Android APK

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build-apk:
    runs-on: ubuntu-latest
    steps:
      - name: 1. 检出当前仓库
        uses: actions/checkout@v4

      - name: 2. 拉取 takboo/dsh-coopanion 官方仓库提取大肥鱼前端与角色资源
        run: |
          git clone --depth 1 https://github.com/takboo/dsh-coopanion.git /tmp/dsh-coopanion
          mkdir -p /tmp/whale-android/app/src/main/assets/www
          cp -r /tmp/dsh-coopanion/web/* /tmp/whale-android/app/src/main/assets/www/ || true
          if [ -d "/tmp/dsh-coopanion/assets" ]; then
            cp -r /tmp/dsh-coopanion/assets /tmp/whale-android/app/src/main/assets/www/assets || true
          fi
          # 生成资源索引清单，方便前端自动定位大肥鱼贴图与模型文件
          python3 - << 'PY'
          import os, json
          root = '/tmp/whale-android/app/src/main/assets/www'
          files = []
          for dirpath, _, filenames in os.walk(root):
              for f in filenames:
                  rel = os.path.relpath(os.path.join(dirpath, f), root).replace('\\', '/')
                  files.append(rel)
          with open(os.path.join(root, 'whale-assets-manifest.json'), 'w', encoding='utf-8') as out:
              json.dump({'files': sorted(files)}, out, ensure_ascii=False, indent=2)
          print(f"Extracted {len(files)} files from takboo/dsh-coopanion")
          PY

      - name: 3. 配置 JDK 17 与 Android 编译环境
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: 4. 挂载 Android SDK
        uses: android-actions/setup-android@v3

      - name: 5. 生成独立安卓工程（含系统声音内录 AudioPlaybackCapture + 语音识别 + OpenAI 接口）
        run: |
          python3 - << 'PY'
          import os, textwrap

          base = '/tmp/whale-android'
          java_dir = os.path.join(base, 'app/src/main/java/com/takboo/whalecompanion')
          res_layout = os.path.join(base, 'app/src/main/res/layout')
          res_values = os.path.join(base, 'app/src/main/res/values')
          www_dir = os.path.join(base, 'app/src/main/assets/www')
          os.makedirs(java_dir, exist_ok=True)
          os.makedirs(res_layout, exist_ok=True)
          os.makedirs(res_values, exist_ok=True)
          os.makedirs(www_dir, exist_ok=True)

          # 1. settings.gradle & build.gradle
          with open(os.path.join(base, 'settings.gradle'), 'w') as f:
              f.write("rootProject.name = 'WhaleCompanion'\ninclude ':app'\n")

          with open(os.path.join(base, 'build.gradle'), 'w') as f:
              f.write(textwrap.dedent("""\
              buildscript {
                  repositories {
                      google()
                      mavenCentral()
                  }
                  dependencies {
                      classpath 'com.android.tools.build:gradle:8.2.2'
                  }
              }
              allprojects {
                  repositories {
                      google()
                      mavenCentral()
                  }
              }
              """))

          with open(os.path.join(base, 'gradle.properties'), 'w') as f:
              f.write("android.useAndroidX=true\norg.gradle.jvmargs=-Xmx2048m\n")

          with open(os.path.join(base, 'app/build.gradle'), 'w') as f:
              f.write(textwrap.dedent("""\
              plugins {
                  id 'com.android.application'
              }
              android {
                  namespace 'com.takboo.whalecompanion'
                  compileSdk 34
                  defaultConfig {
                      applicationId "com.takboo.whalecompanion"
                      minSdk 29
                      targetSdk 34
                      versionCode 1
                      versionName "1.0.0-standalone"
                  }
                  buildTypes {
                      debug {
                          minifyEnabled false
                      }
                  }
                  compileOptions {
                      sourceCompatibility JavaVersion.VERSION_17
                      targetCompatibility JavaVersion.VERSION_17
                  }
              }
              dependencies {
                  implementation 'androidx.appcompat:appcompat:1.6.1'
                  implementation 'androidx.core:core:1.12.0'
                  implementation 'androidx.webkit:webkit:1.9.0'
              }
              """))

          # 2. AndroidManifest.xml (含 RECORD_AUDIO 与 FOREGROUND_SERVICE_MEDIA_PROJECTION)
          with open(os.path.join(base, 'app/src/main/AndroidManifest.xml'), 'w') as f:
              f.write(textwrap.dedent("""\
              <?xml version="1.0" encoding="utf-8"?>
              <manifest xmlns:android="http://schemas.android.com/apk/res/android">
                  <uses-permission android:name="android.permission.INTERNET" />
                  <uses-permission android:name="android.permission.RECORD_AUDIO" />
                  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
                  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
                  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

                  <application
                      android:allowBackup="true"
                      android:label="大肥鱼伴侣"
                      android:usesCleartextTraffic="true"
                      android:theme="@style/Theme.AppCompat.NoActionBar">

                      <activity
                          android:name=".MainActivity"
                          android:exported="true"
                          android:configChanges="orientation|screenSize|keyboardHidden">
                          <intent-filter>
                              <action android:name="android.intent.action.MAIN" />
                              <category android:name="android.intent.category.LAUNCHER" />
                          </intent-filter>
                      </activity>

                      <service
                          android:name=".SystemAudioCaptureService"
                          android:enabled="true"
                          android:exported="false"
                          android:foregroundServiceType="mediaProjection" />
                  </application>
              </manifest>
              """))

          # 3. SystemAudioCaptureService.java (使用 Android 10+ AudioPlaybackCapture 捕获系统音乐/视频声音)
          with open(os.path.join(java_dir, 'SystemAudioCaptureService.java'), 'w') as f:
              f.write(textwrap.dedent("""\
              package com.takboo.whalecompanion;

              import android.app.Activity;
              import android.app.Notification;
              import android.app.NotificationChannel;
              import android.app.NotificationManager;
              import android.app.Service;
              import android.content.Context;
              import android.content.Intent;
              import android.media.AudioAttributes;
              import android.media.AudioFormat;
              import android.media.AudioPlaybackCaptureConfiguration;
              import android.media.AudioRecord;
              import android.media.projection.MediaProjection;
              import android.media.projection.MediaProjectionManager;
              import android.os.Build;
              import android.os.IBinder;
              import android.util.Base64;
              import androidx.core.app.NotificationCompat;
              import java.io.ByteArrayOutputStream;
              import java.nio.ByteBuffer;
              import java.nio.ByteOrder;

              public class SystemAudioCaptureService extends Service {
                  public static final String ACTION_START = "ACTION_START_AUDIO_CAPTURE";
                  public static final String ACTION_STOP = "ACTION_STOP_AUDIO_CAPTURE";
                  public static final String EXTRA_RESULT_DATA = "EXTRA_RESULT_DATA";
                  private static final String CHANNEL_ID = "WhaleAudioCaptureChannel";

                  private MediaProjection mediaProjection;
                  private AudioRecord audioRecord;
                  private volatile boolean isCapturing = false;
                  private Thread captureThread;

                  public interface AudioCallback {
                      void onBeatLevel(double rms, boolean isBeat);
                      void onWavSegmentReady(String base64Wav);
                      void onStatusChanged(boolean active, String message);
                  }

                  public static AudioCallback callback;
                  public static volatile boolean enableAutoSliceWav = false;

                  @Override
                  public void onCreate() {
                      super.onCreate();
                      createNotificationChannel();
                  }

                  @Override
                  public int onStartCommand(Intent intent, int flags, int startId) {
                      if (intent == null) return START_NOT_STICKY;
                      String action = intent.getAction();
                      if (ACTION_STOP.equals(action)) {
                          stopCapture();
                          stopSelf();
                          return START_NOT_STICKY;
                      }
                      if (ACTION_START.equals(action)) {
                          Notification notification = new NotificationCompat.Builder(this, CHANNEL_ID)
                                  .setContentTitle("大肥鱼正在陪你听歌/看视频")
                                  .setContentText("实时感知系统声音律动与视频台词中...")
                                  .setSmallIcon(android.R.drawable.ic_btn_speak_now)
                                  .setPriority(NotificationCompat.PRIORITY_LOW)
                                  .build();
                          startForeground(1001, notification);

                          Intent data = intent.getParcelableExtra(EXTRA_RESULT_DATA);
                          if (data != null) {
                              startAudioPlaybackCapture(data);
                          }
                      }
                      return START_STICKY;
                  }

                  private void startAudioPlaybackCapture(Intent projectionData) {
                      try {
                          MediaProjectionManager mpm = (MediaProjectionManager) getSystemService(Context.MEDIA_PROJECTION_SERVICE);
                          mediaProjection = mpm.getMediaProjection(Activity.RESULT_OK, projectionData);
                          if (mediaProjection == null) {
                              if (callback != null) callback.onStatusChanged(false, "未获取到系统声音授权");
                              return;
                          }

                          AudioPlaybackCaptureConfiguration config = new AudioPlaybackCaptureConfiguration.Builder(mediaProjection)
                                  .addMatchingUsage(AudioAttributes.USAGE_MEDIA)
                                  .addMatchingUsage(AudioAttributes.USAGE_GAME)
                                  .addMatchingUsage(AudioAttributes.USAGE_UNKNOWN)
                                  .build();

                          int sampleRate = 16000;
                          int bufferSize = Math.max(
                                  AudioRecord.getMinBufferSize(sampleRate, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT),
                                  sampleRate * 2
                          );

                          AudioFormat format = new AudioFormat.Builder()
                                  .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
                                  .setSampleRate(sampleRate)
                                  .setChannelMask(AudioFormat.CHANNEL_IN_MONO)
                                  .build();

                          audioRecord = new AudioRecord.Builder()
                                  .setAudioFormat(format)
                                  .setBufferSizeInBytes(bufferSize)
                                  .setAudioPlaybackCaptureConfig(config)
                                  .build();

                          audioRecord.startRecording();
                          isCapturing = true;
                          if (callback != null) callback.onStatusChanged(true, "已开启系统声音互动");

                          captureThread = new Thread(() -> {
                              short[] readBuffer = new short[1600]; // 100ms @ 16kHz
                              ByteArrayOutputStream pcmAccumulator = new ByteArrayOutputStream();
                              double avgEnergy = 0.02;
                              int activeFrames = 0;

                              while (isCapturing && audioRecord != null) {
                                  int read = audioRecord.read(readBuffer, 0, readBuffer.length);
                                  if (read > 0) {
                                      long sumSq = 0;
                                      for (int i = 0; i < read; i++) {
                                          sumSq += (long) readBuffer[i] * readBuffer[i];
                                      }
                                      double rms = Math.sqrt((double) sumSq / read) / 32768.0;
                                      boolean isBeat = rms > 0.035 && rms > avgEnergy * 1.45;
                                      avgEnergy = avgEnergy * 0.85 + rms * 0.15;

                                      if (callback != null) {
                                          callback.onBeatLevel(Math.min(1.0, rms * 4.5), isBeat);
                                      }

                                      if (enableAutoSliceWav) {
                                          if (rms > 0.015) {
                                              activeFrames++;
                                              ByteBuffer bb = ByteBuffer.allocate(read * 2).order(ByteOrder.LITTLE_ENDIAN);
                                              for (int i = 0; i < read; i++) bb.putShort(readBuffer[i]);
                                              pcmAccumulator.write(bb.array(), 0, read * 2);
                                          }
                                          // 每满约 6 秒有效系统音频（60 帧 x 100ms），打包成 16kHz 单声道 WAV 送给前端识别
                                          if (activeFrames >= 60) {
                                              byte[] pcmBytes = pcmAccumulator.toByteArray();
                                              pcmAccumulator.reset();
                                              activeFrames = 0;
                                              String b64 = Base64.encodeToString(buildWavHeader(pcmBytes, sampleRate), Base64.NO_WRAP);
                                              if (callback != null) callback.onWavSegmentReady(b64);
                                          }
                                      } else {
                                          pcmAccumulator.reset();
                                          activeFrames = 0;
                                      }
                                  }
                              }
                          }, "WhaleSystemAudioThread");
                          captureThread.start();
                      } catch (Exception e) {
                          if (callback != null) callback.onStatusChanged(false, "系统声音捕获异常: " + e.getMessage());
                      }
                  }

                  private byte[] buildWavHeader(byte[] pcmData, int sampleRate) {
                      int totalDataLen = pcmData.length + 36;
                      long byteRate = sampleRate * 2;
                      ByteBuffer header = ByteBuffer.allocate(44 + pcmData.length).order(ByteOrder.LITTLE_ENDIAN);
                      header.put("RIFF".getBytes());
                      header.putInt(totalDataLen);
                      header.put("WAVE".getBytes());
                      header.put("fmt ".getBytes());
                      header.putInt(16);
                      header.putShort((short) 1); // PCM
                      header.putShort((short) 1); // Mono
                      header.putInt(sampleRate);
                      header.putInt((int) byteRate);
                      header.putShort((short) 2);
                      header.putShort((short) 16);
                      header.put("data".getBytes());
                      header.putInt(pcmData.length);
                      header.put(pcmData);
                      return header.array();
                  }

                  private void stopCapture() {
                      isCapturing = false;
                      try {
                          if (audioRecord != null) {
                              audioRecord.stop();
                              audioRecord.release();
                              audioRecord = null;
                          }
                          if (mediaProjection != null) {
                              mediaProjection.stop();
                              mediaProjection = null;
                          }
                      } catch (Exception ignored) {}
                      if (callback != null) callback.onStatusChanged(false, "已停止系统声音捕获");
                  }

                  @Override
                  public void onDestroy() {
                      stopCapture();
                      super.onDestroy();
                  }

                  @Override
                  public IBinder onBind(Intent intent) {
                      return null;
                  }

                  private void createNotificationChannel() {
                      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                          NotificationChannel channel = new NotificationChannel(
                                  CHANNEL_ID, "大肥鱼系统声音陪伴", NotificationManager.IMPORTANCE_LOW);
                          NotificationManager nm = getSystemService(NotificationManager.class);
                          if (nm != null) nm.createNotificationChannel(channel);
                      }
                  }
              }
              """))

          # 4. MainActivity.java (承载透明本地 Web 资源服务器 + 原生语音识别 + 系统内录桥接)
          with open(os.path.join(java_dir, 'MainActivity.java'), 'w') as f:
              f.write(textwrap.dedent("""\
              package com.takboo.whalecompanion;

              import android.Manifest;
              import android.app.Activity;
              import android.content.Context;
              import android.content.Intent;
              import android.content.pm.PackageManager;
              import android.media.projection.MediaProjectionManager;
              import android.net.Uri;
              import android.os.Build;
              import android.os.Bundle;
              import android.speech.RecognitionListener;
              import android.speech.RecognizerIntent;
              import android.speech.SpeechRecognizer;
              import android.webkit.JavascriptInterface;
              import android.webkit.PermissionRequest;
              import android.webkit.WebChromeClient;
              import android.webkit.WebResourceRequest;
              import android.webkit.WebResourceResponse;
              import android.webkit.WebSettings;
              import android.webkit.WebView;
              import android.webkit.WebViewClient;
              import androidx.appcompat.app.AppCompatActivity;
              import androidx.core.app.ActivityCompat;
              import androidx.core.content.ContextCompat;
              import androidx.webkit.WebViewAssetLoader;
              import java.util.ArrayList;
              import java.util.Locale;

              public class MainActivity extends AppCompatActivity {
                  private static final int REQ_MEDIA_PROJECTION = 2001;
                  private static final int REQ_RECORD_AUDIO = 2002;
                  private WebView webView;
                  private SpeechRecognizer speechRecognizer;

                  @Override
                  protected void onCreate(Bundle savedInstanceState) {
                      super.onCreate(savedInstanceState);
                      webView = new WebView(this);
                      setContentView(webView);

                      WebSettings settings = webView.getSettings();
                      settings.setJavaScriptEnabled(true);
                      settings.setDomStorageEnabled(true);
                      settings.setMediaPlaybackRequiresUserGesture(false);
                      settings.setAllowFileAccess(true);
                      settings.setAllowContentAccess(true);

                      final WebViewAssetLoader assetLoader = new WebViewAssetLoader.Builder()
                              .addPathHandler("/assets/", new WebViewAssetLoader.AssetsPathHandler(this))
                              .build();

                      webView.setWebViewClient(new WebViewClient() {
                          @Override
                          public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest request) {
                              return assetLoader.shouldInterceptRequest(request.getUrl());
                          }
                      });

                      webView.setWebChromeClient(new WebChromeClient() {
                          @Override
                          public void onPermissionRequest(final PermissionRequest request) {
                              runOnUiThread(() -> request.grant(request.getResources()));
                          }
                      });

                      webView.addJavascriptInterface(new AndroidBridge(), "AndroidBridge");

                      SystemAudioCaptureService.callback = new SystemAudioCaptureService.AudioCallback() {
                          @Override
                          public void onBeatLevel(double rms, boolean isBeat) {
                              runOnUiThread(() -> webView.evaluateJavascript(
                                      String.format(Locale.US, "window.onSystemAudioBeat && window.onSystemAudioBeat(%.4f, %b);", rms, isBeat), null));
                          }

                          @Override
                          public void onWavSegmentReady(String base64Wav) {
                              runOnUiThread(() -> webView.evaluateJavascript(
                                      "window.onSystemAudioWav && window.onSystemAudioWav('" + base64Wav + "');", null));
                          }

                          @Override
                          public void onStatusChanged(boolean active, String msg) {
                              String safeMsg = msg.replace("'", "\\'");
                              runOnUiThread(() -> webView.evaluateJavascript(
                                      "window.onSystemAudioStatus && window.onSystemAudioStatus(" + active + ", '" + safeMsg + "');", null));
                          }
                      };

                      ensureAudioPermission();
                      webView.loadUrl("https://appassets.androidplatform.net/assets/www/companion-standalone.html");
                  }

                  private void ensureAudioPermission() {
                      if (ContextCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO)
                              != PackageManager.PERMISSION_GRANTED) {
                          ActivityCompat.requestPermissions(this,
                                  new String[]{Manifest.permission.RECORD_AUDIO}, REQ_RECORD_AUDIO);
                      }
                  }

                  @Override
                  protected void onActivityResult(int requestCode, int resultCode, Intent data) {
                      super.onActivityResult(requestCode, resultCode, data);
                      if (requestCode == REQ_MEDIA_PROJECTION) {
                          if (resultCode == Activity.RESULT_OK && data != null) {
                              Intent serviceIntent = new Intent(this, SystemAudioCaptureService.class);
                              serviceIntent.setAction(SystemAudioCaptureService.ACTION_START);
                              serviceIntent.putExtra(SystemAudioCaptureService.EXTRA_RESULT_DATA, data);
                              if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                                  startForegroundService(serviceIntent);
                              } else {
                                  startService(serviceIntent);
                              }
                          } else {
                              webView.evaluateJavascript("window.onSystemAudioStatus && window.onSystemAudioStatus(false, '已取消系统声音授权');", null);
                          }
                      }
                  }

                  public class AndroidBridge {
                      @JavascriptInterface
                      public void startSystemAudioCapture(boolean autoSliceWav) {
                          SystemAudioCaptureService.enableAutoSliceWav = autoSliceWav;
                          ensureAudioPermission();
                          MediaProjectionManager mpm = (MediaProjectionManager) getSystemService(Context.MEDIA_PROJECTION_SERVICE);
                          if (mpm != null) {
                              startActivityForResult(mpm.createScreenCaptureIntent(), REQ_MEDIA_PROJECTION);
                          }
                      }

                      @JavascriptInterface
                      public void setAutoSliceWav(boolean enabled) {
                          SystemAudioCaptureService.enableAutoSliceWav = enabled;
                      }

                      @JavascriptInterface
                      public void stopSystemAudioCapture() {
                          Intent serviceIntent = new Intent(MainActivity.this, SystemAudioCaptureService.class);
                          serviceIntent.setAction(SystemAudioCaptureService.ACTION_STOP);
                          startService(serviceIntent);
                      }

                      @JavascriptInterface
                      public void startNativeSpeechRecognition() {
                          runOnUiThread(() -> {
                              ensureAudioPermission();
                              if (speechRecognizer != null) {
                                  speechRecognizer.destroy();
                              }
                              speechRecognizer = SpeechRecognizer.createSpeechRecognizer(MainActivity.this);
                              speechRecognizer.setRecognitionListener(new RecognitionListener() {
                                  @Override public void onReadyForSpeech(Bundle params) {
                                      webView.evaluateJavascript("window.onNativeSpeechState && window.onNativeSpeechState('listening');", null);
                                  }
                                  @Override public void onBeginningOfSpeech() {}
                                  @Override public void onRmsChanged(float rmsdB) {}
                                  @Override public void onBufferReceived(byte[] buffer) {}
                                  @Override public void onEndOfSpeech() {
                                      webView.evaluateJavascript("window.onNativeSpeechState && window.onNativeSpeechState('processing');", null);
                                  }
                                  @Override public void onError(int error) {
                                      webView.evaluateJavascript("window.onNativeSpeechError && window.onNativeSpeechError(" + error + ");", null);
                                  }
                                  @Override public void onResults(Bundle results) {
                                      ArrayList<String> matches = results.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION);
                                      if (matches != null && !matches.isEmpty()) {
                                          String text = matches.get(0).replace("'", "\\'");
                                          webView.evaluateJavascript("window.onNativeSpeechResult && window.onNativeSpeechResult('" + text + "');", null);
                                      }
                                  }
                                  @Override public void onPartialResults(Bundle partialResults) {}
                                  @Override public void onEvent(int eventType, Bundle params) {}
                              });
                              Intent intent = new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH);
                              intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM);
                              intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE, Locale.getDefault());
                              speechRecognizer.startListening(intent);
