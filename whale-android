                    formData.append('file', wavBlob, 'system_audio.wav');
                    formData.append('model', config.asrModel || 'FunAudioLLM/SenseVoiceSmall');
                    const res = await fetch(`${config.baseUrl.replace(/\/$/, '')}/audio/transcriptions`, {
                      method: 'POST',
                      headers: { 'Authorization': `Bearer ${config.apiKey}` },
                      body: formData
                    });
                    if (!res.ok) return '';
                    const data = await res.json();
                    return data.text || '';
                  }

                  // 8. 自定义第三方 OpenAI 格式流式对话 + 实时动嘴同步
                  async function sendChatMessage() {
                    const input = document.getElementById('chat-input');
                    const text = input.value.trim();
                    if (!text) return;
                    input.value = '';
                    await askWhaleLLM(text, true);
                  }

                  async function askWhaleLLM(userText, showUserEcho) {
                    if (!config.apiKey) {
                      showBubble('请先点击右上角「⚙️ 接口设置」填入你的 API Key 哦！', 6000);
                      openSettings();
                      return;
                    }
                    petState.mood = 'thinking';
                    if (showUserEcho) showBubble('思考中...', 0);

                    chatHistory.push({ role: 'user', content: userText });
                    if (chatHistory.length > 16) chatHistory = chatHistory.slice(-16);

                    try {
                      const response = await fetch(`${config.baseUrl.replace(/\/$/, '')}/chat/completions`, {
                        method: 'POST',
                        headers: {
                          'Content-Type': 'application/json',
                          'Authorization': `Bearer ${config.apiKey}`
                        },
                        body: JSON.stringify({
                          model: config.model || 'deepseek-chat',
                          stream: true,
                          messages: [
                            { role: 'system', content: config.sysPrompt },
                            ...chatHistory
                          ]
                        })
                      });

                      if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                      }

                      const reader = response.body.getReader();
                      const decoder = new TextDecoder('utf-8');
                      let reply = '';

                      while (true) {
                        const { done, value } = await reader.read();
                        if (done) break;
                        const chunk = decoder.decode(value, { stream: true });
                        const lines = chunk.split('\n').filter(l => l.trim().startsWith('data:'));
                        for (const line of lines) {
                          const payload = line.replace(/^data:\s*/, '').trim();
                          if (payload === '[DONE]') break;
                          try {
                            const parsed = JSON.parse(payload);
                            const delta = parsed.choices?.[0]?.delta?.content || '';
                            if (delta) {
                              reply += delta;
                              petState.mouthOpen = 0.9; // 收到流式新字时张嘴
                              showBubble(reply, 12000);
                            }
                          } catch (_) {}
                        }
                      }

                      chatHistory.push({ role: 'assistant', content: reply });
                      petState.mood = intimacy >= 6 ? 'love' : 'happy';
                      petState.beatBounce = 0.45;
                    } catch (err) {
                      petState.mood = 'calm';
                      showBubble('接口请求失败 (' + err.message + ')，请检查右上角 ⚙️ 接口地址与 Key 是否正确。', 7000);
                    }
                  }

                  // 9. 设置弹窗逻辑
                  function openSettings() {
                    document.getElementById('cfg-base-url').value = config.baseUrl;
                    document.getElementById('cfg-api-key').value = config.apiKey;
                    document.getElementById('cfg-model').value = config.model;
                    document.getElementById('cfg-asr-model').value = config.asrModel;
                    document.getElementById('cfg-auto-video-comment').value = String(Boolean(config.autoVideoComment));
                    document.getElementById('cfg-sys-prompt').value = config.sysPrompt;
                    document.getElementById('settings-modal').style.display = 'flex';
                  }
                  function closeSettings() {
                    document.getElementById('settings-modal').style.display = 'none';
                  }
                  function saveSettings() {
                    config.baseUrl = document.getElementById('cfg-base-url').value.trim() || DEFAULT_CFG.baseUrl;
                    config.apiKey = document.getElementById('cfg-api-key').value.trim();
                    config.model = document.getElementById('cfg-model').value.trim() || DEFAULT_CFG.model;
                    config.asrModel = document.getElementById('cfg-asr-model').value.trim() || DEFAULT_CFG.asrModel;
                    config.autoVideoComment = document.getElementById('cfg-auto-video-comment').value === 'true';
                    config.sysPrompt = document.getElementById('cfg-sys-prompt').value.trim() || DEFAULT_CFG.sysPrompt;
                    localStorage.setItem('whale_cfg', JSON.stringify(config));
                    if (window.AndroidBridge) {
                      window.AndroidBridge.setAutoSliceWav(config.autoVideoComment);
                    }
                    closeSettings();
                    showBubble('配置已保存！现在可以陪你聊天、听歌和看视频啦～', 4000);
                  }

                  requestAnimationFrame(renderWhaleFrame);
                </script>
              </body>
              </html>
              """))
          print("Android project generated successfully.")
          PY

